# Minimal PAP/CHAP and SQL-backed accounting virtual server for the laboratory.
server default {
  listen {
    type = auth
    ipaddr = *
    port = 1812
  }
  listen {
    type = acct
    ipaddr = *
    port = 1813
  }
  authorize {
    preprocess
    chap
    mschap
    suffix
    sql
    expiration
    pap
  }
  authenticate {
    Auth-Type PAP {
      pap
    }
    Auth-Type CHAP {
      chap
    }
    Auth-Type MS-CHAP {
      mschap
    }
  }
  preacct {
    preprocess
    acct_unique
    suffix
  }
  accounting {
    sql
  }
  post-auth {
    sql
  }
}
